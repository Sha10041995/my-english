# LinguaQuest AI – environment variables.
# The app runs with NONE of these set (demo mode: rule-based feedback, browser speech, data in localStorage).
# Secrets are only read on the server. Only NEXT_PUBLIC_* values reach the browser.

# ---- LLM tutoring & writing feedback ------------------------------------------
# none | anthropic | openai-compatible
AI_PROVIDER=none
AI_TIMEOUT_MS=20000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Server-side speech (optional; otherwise browser dictation / voices are used) --
# none | openai-compatible
SPEECH_PROVIDER=none
# SPEECH_API_KEY=            # falls back to OPENAI_API_KEY
# SPEECH_BASE_URL=
SPEECH_STT_MODEL=whisper-1
SPEECH_TTS_MODEL=tts-1
SPEECH_TTS_VOICE=alloy

# ---- Accounts & cloud backup (Supabase; optional) --------------------------------
# Anon key only. NEVER put the service-role key in this app's environment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
